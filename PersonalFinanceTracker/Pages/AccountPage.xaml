<?xml version="1.0" encoding="utf-8" ?>
<!-- Accounts overview & management. Uses SelectionChanged for navigation (robust). -->
<ContentPage
    x:Class="PersonalFinanceTracker.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pm="clr-namespace:PersonalFinanceTracker.PageModels"
    xmlns:m="clr-namespace:PersonalFinanceTracker.Models"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    x:Name="AccountPageRoot"
    x:DataType="pm:AccountPageModel"
    Title="资产账户">

    <!-- Toolbar: refresh & add -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="刷新" Priority="0" Order="Primary" Command="{Binding LoadCommand}" />
        <ToolbarItem Text="新增" Priority="1" Order="Primary" Command="{Binding ShowAddAccountPopupCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Summary: Total assets -->
            <Frame Padding="16" HasShadow="True" CornerRadius="12">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="总资产" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding TotalAssets, StringFormat='{}{0:C}'}"
                           FontSize="16" FontAttributes="Bold" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Last 4 months trend line chart -->
            <Frame Padding="16" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="过去4个月的总资产趋势" FontAttributes="Bold" FontSize="16"/>
                    <chart:SfCartesianChart>
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis ShowMajorGridLines="False" />
                        </chart:SfCartesianChart.XAxes>
                        <chart:SfCartesianChart.YAxes>
                                <chart:NumericalAxis
                                ShowMajorGridLines="True"
                                Minimum="{Binding YMin}"
                                Maximum="{Binding YMax}"
                                Interval="{Binding YInterval}" />   
                        </chart:SfCartesianChart.YAxes>
                        <chart:LineSeries
                            ItemsSource="{Binding Last4MonthsTrend}"
                            XBindingPath="Key"
                            YBindingPath="Value"
                            ShowMarkers="True"
                            EnableTooltip="True" />
                    </chart:SfCartesianChart>
                </VerticalStackLayout>
            </Frame>

            <!-- Accounts list (Selection-based navigation) -->
            <Frame Padding="0" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout>
                    <Grid Padding="16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Label Text="所有账户" FontAttributes="Bold" FontSize="16" />
                        <ImageButton Grid.Column="1" Source="refresh.png" WidthRequest="28" HeightRequest="28"
                                     BackgroundColor="Transparent" Padding="0" Command="{Binding LoadCommand}" />
                        <ImageButton Grid.Column="2" Source="add.png" WidthRequest="28" HeightRequest="28"
                                     BackgroundColor="Transparent" Padding="0" Command="{Binding ShowAddAccountPopupCommand}" />
                    </Grid>

                    <CollectionView x:Name="AccountsView"
                        ItemsSource="{Binding Accounts}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                        SelectionChangedCommand="{Binding OpenAccountDetailCommand}"
                        ItemSizingStrategy="MeasureAllItems">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:Account">
                                <SwipeView x:DataType="{x:Null}">
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem
                                                x:DataType="{x:Null}"
                                                BindingContext="{Binding .}"
                                                Text="删除"
                                                BackgroundColor="IndianRed"
                                                Command="{Binding BindingContext.ShowDeleteAccountPopupCommand, Source={x:Reference AccountPageRoot}}"
                                                CommandParameter="{Binding Id}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Balance, StringFormat='{}{0:C}'}"
                                               HorizontalTextAlignment="End"
                                               FontSize="14" />
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
