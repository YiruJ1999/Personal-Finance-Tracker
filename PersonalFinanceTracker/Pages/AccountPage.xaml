<?xml version="1.0" encoding="utf-8" ?>
<!-- AccountPage.xaml: View for accounts overview & management -->
<ContentPage
    x:Class="PersonalFinanceTracker.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PersonalFinanceTracker.Pages"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    Title="Accounts">

    <!-- Page-level resources: register converters -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- True if value is NOT null -->
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Summary: Total assets -->
            <Frame Padding="16" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="总资产" FontAttributes="Bold" FontSize="16"/>
                    <Label Text="{Binding TotalAssets, StringFormat='{}{0:C}'}"
                           FontSize="24" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>
            <Label Text="{Binding Last4MonthsTrend.Count, StringFormat='点数: {0}'}" />
            <!-- Last 4 months trend line chart -->
            <Frame Padding="16" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="过去4个月的总资产趋势"
                           FontAttributes="Bold" FontSize="16"/>
                    <chart:SfCartesianChart x:Name="AssetsTrendChart">
                        <!-- Category axis for month keys (e.g., 2025-06) -->
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis ShowMajorGridLines="False" />
                        </chart:SfCartesianChart.XAxes>

                        <!-- Numeric axis with currency format -->
                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis ShowMajorGridLines="True"  />
                        </chart:SfCartesianChart.YAxes>

                        <!-- Bind to Dictionary<string, decimal> (Key -> X, Value -> Y) -->
                        <chart:LineSeries
                            ItemsSource="{Binding Last4MonthsTrend}"
                            XBindingPath="Key"
                            YBindingPath="Value"
                            ShowMarkers="True"
                            EnableTooltip="True" />
                    </chart:SfCartesianChart>
                </VerticalStackLayout>
            </Frame>

            <!-- Accounts list -->
            <Frame Padding="0" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout>
                    <Grid Padding="16" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Text="Accounts" FontAttributes="Bold" FontSize="16" />
                        <Button Grid.Column="1" Text="Reload"
                                Command="{Binding LoadCommand}" />
                    </Grid>

                    <CollectionView
                        ItemsSource="{Binding Accounts}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="12,6" Padding="12" CornerRadius="10" HasShadow="False">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <!-- Account name -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontAttributes="Bold" FontSize="16"/>
                                        <!-- Current balance -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Balance, StringFormat='{}{0:C}'}"
                                               FontAttributes="Bold" FontSize="16"/>

                                        <!-- Account type and created time -->
                                        <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="12">
                                            <Label Text="{Binding Type, StringFormat='Type: {0}'}"
                                                   FontSize="12" />
                                            <Label Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd}'}"
                                                   FontSize="12" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Edit selected account balance -->
            <Frame Padding="16" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="编辑选中账户余额"
                           FontAttributes="Bold" FontSize="16"/>

                    <!-- Selected summary -->
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="已选账户：" FontAttributes="Bold"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAccount.Name}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="账户余额：" FontAttributes="Bold"/>
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding SelectedAccount.Balance, StringFormat='{}{0:C}'}" />
                    </Grid>

                    <!-- New balance input -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Entry WidthRequest="180" Keyboard="Numeric"
                               Placeholder="请输入新的余额"
                               Text="{Binding EditedBalance, Mode=TwoWay}" />
                        <Button Text="更新"
                                Command="{Binding UpdateBalanceCommand}"
                                IsEnabled="{Binding SelectedAccount, Converter={StaticResource IsNotNullConverter}}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Add / Delete account -->
            <Frame Padding="16" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Add / Delete Account"
                           FontAttributes="Bold" FontSize="16"/>

                    <!-- Add account row -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <Entry Placeholder="Account name"
                               Text="{Binding NewAccountName, Mode=TwoWay}" />
                        <Entry Grid.Column="1" WidthRequest="140" Keyboard="Numeric"
                               Placeholder="Opening balance"
                               Text="{Binding NewAccountOpeningBalance, Mode=TwoWay}" />
                        <Button Grid.Column="2" Text="Add"
                                Command="{Binding AddAccountCommand}" />
                    </Grid>

                    <!-- Delete selected account -->
                    <Button Text="Delete Selected"
                            Command="{Binding DeleteAccountCommand}"
                            IsEnabled="{Binding SelectedAccount, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="12" Opacity="0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
