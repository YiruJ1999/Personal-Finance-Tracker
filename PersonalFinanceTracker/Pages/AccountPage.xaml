<?xml version="1.0" encoding="utf-8" ?>
<!-- AccountPage.xaml: View for accounts overview & management -->
<ContentPage
    x:Class="PersonalFinanceTracker.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PersonalFinanceTracker.Pages"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    Title="Accounts"
    x:Name="AccountPageRoot">

    <!-- Page-level resources: register converters -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- True if value is NOT null -->
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Summary: Total assets -->
            <Frame Padding="16" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="总资产" FontAttributes="Bold" FontSize="16"/>
                    <Label Text="{Binding TotalAssets, StringFormat='{}{0:C}'}"
                           FontSize="24" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>
            <Label Text="{Binding Last4MonthsTrend.Count, StringFormat='点数: {0}'}" />
            <!-- Last 4 months trend line chart -->
            <Frame Padding="16" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="过去4个月的总资产趋势"
                           FontAttributes="Bold" FontSize="16"/>
                    <chart:SfCartesianChart x:Name="AssetsTrendChart">
                        <!-- Category axis for month keys (e.g., 2025-06) -->
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis ShowMajorGridLines="False" />
                        </chart:SfCartesianChart.XAxes>

                        <!-- Numeric axis with currency format -->
                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis ShowMajorGridLines="True"  />
                        </chart:SfCartesianChart.YAxes>

                        <!-- Bind to Dictionary<string, decimal> (Key -> X, Value -> Y) -->
                        <chart:LineSeries
                            ItemsSource="{Binding Last4MonthsTrend}"
                            XBindingPath="Key"
                            YBindingPath="Value"
                            ShowMarkers="True"
                            EnableTooltip="True" />
                    </chart:SfCartesianChart>
                </VerticalStackLayout>
            </Frame>

            <!-- Accounts list -->
            <Frame Padding="0" HasShadow="True" CornerRadius="12">
                <VerticalStackLayout>
                    <Grid Padding="16" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Text="所有账户" FontAttributes="Bold" FontSize="16" />
                        <Button Grid.Column="1" Text="刷新"
                                Command="{Binding LoadCommand}" />
                        <Button Grid.Column="2" Text="添加"
                                Command="{Binding ShowAddAccountPopupCommand}" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Accounts}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <!-- Swipe to delete opens Delete popup -->
                                            <SwipeItem Text="删除" BackgroundColor="IndianRed"
                                               Command="{Binding BindingContext.ShowDeleteAccountPopupCommand, Source={x:Reference Name=AccountPageRoot}}"
                                               CommandParameter="{Binding Name}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Grid Padding="12" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Grid.Column="1"
                                           Text="{Binding Balance, StringFormat='{0:C}'}"
                                           HorizontalTextAlignment="End" />

                                        <!-- Tap to navigate into detail -->
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.OpenAccountDetailCommand, Source={x:Reference Name=AccountPageRoot}}"
                                                CommandParameter="{Binding Name}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
