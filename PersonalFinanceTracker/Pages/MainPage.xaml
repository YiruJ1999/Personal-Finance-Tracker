<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PersonalFinanceTracker.PageModels"
             xmlns:models="clr-namespace:PersonalFinanceTracker.Models"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
             x:Class="PersonalFinanceTracker.Pages.MainPage"
             x:DataType="local:MainPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource LightBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">

                <!-- Current Book -->
                <Border
                     BackgroundColor="{StaticResource PrimaryLight}"  
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    Padding="10,6"
                    HorizontalOptions="Start">
                    <Label
                        Text="{Binding CurrentBookText}"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource PrimaryDark}" />
                </Border>

                <!-- Monthly Summary -->
                <Label Text="{loc:Translate Label_MonthlySummary}"
                       Style="{StaticResource Title2}"
                       HorizontalOptions="Center"
                       Margin="0,10"/>

                <Grid ColumnDefinitions="*,*,*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="8">

                    <!-- Summary Labels -->
                    <Label Text="{Binding MonthlySummaryData[0].Label}" Grid.Row="0" Grid.Column="0" HorizontalOptions="Center"/>
                    <Label Text="{Binding MonthlySummaryData[1].Label}" Grid.Row="0" Grid.Column="1" HorizontalOptions="Center"/>
                    <Label Text="{Binding MonthlySummaryData[2].Label}" Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"/>
                    <Label Text="{Binding MonthlySummaryData[3].Label}" Grid.Row="0" Grid.Column="3" HorizontalOptions="Center"/>

                    <!-- Values -->
                    <Label Text="{Binding MonthlySummaryData[0].Amount, StringFormat='{}{0:C}'}"
                           Grid.Row="1" Grid.Column="0" HorizontalOptions="Center"/>
                    <Label Text="{Binding MonthlySummaryData[1].Amount, StringFormat='{}{0:C}'}"
                           Grid.Row="1" Grid.Column="1" HorizontalOptions="Center"/>
                    <Label Text="{Binding MonthlySummaryData[2].Amount, StringFormat='{}{0:C}'}"
                           Grid.Row="1" Grid.Column="2" HorizontalOptions="Center"/>

                    <!-- Budget with Edit Icon -->
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="3" Spacing="5" HorizontalOptions="Center">
                        <Label Text="{Binding MonthlySummaryData[3].Amount, StringFormat='{}{0:C}'}"
                               VerticalOptions="Center"/>
                        <ImageButton Source="pencil.png"
                                     HeightRequest="20"
                                     WidthRequest="20"
                                     BackgroundColor="Transparent"
                                     Command="{Binding BuggetTappedCommand}"
                                     VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Monthly Category Chart -->
                <chart:SfCartesianChart HeightRequest="280">
                    <chart:SfCartesianChart.XAxes>
                        <chart:CategoryAxis />
                    </chart:SfCartesianChart.XAxes>
                    <chart:SfCartesianChart.YAxes>
                        <chart:NumericalAxis />
                    </chart:SfCartesianChart.YAxes>
                    <chart:SfCartesianChart.Series>
                        <chart:ColumnSeries ItemsSource="{Binding MonthlyCategoryChartData}"
                                            XBindingPath="Category"
                                            YBindingPath="Amount"
                                            ShowDataLabels="True" 
                                            Fill="{StaticResource PrimaryBrush}"/>
                    </chart:SfCartesianChart.Series>
                </chart:SfCartesianChart>

                <!-- Today's list -->
                <Label Text="{loc:Translate Label_TodayList}"
                       Style="{StaticResource Title2}"
                       HorizontalOptions="Center"
                       Margin="0,10"/>

                <CollectionView ItemsSource="{Binding TodayRecords}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Record">
                            <Border Style="{StaticResource CardStyle}" Margin="5">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Category}" FontSize="16" FontAttributes="Bold"/>
                                    <Label FontSize="14">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource AmountWithSignConverter}">
                                                <Binding Path="Amount" />
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding Note}" FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="{loc:Translate Label_EmptyList}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="Gray" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <Border Grid.Row="2"
                Style="{StaticResource BottomBarContainerStyle}">
            <FlexLayout Style="{StaticResource BottomBarFlexStyle}">
                <Button 
                Command="{Binding GoToBookCommand}"
                Style="{StaticResource BottomBarButtonStyle}">
                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Image Source="icon_book.png" HeightRequest="20" WidthRequest="20"/>
                        <Label Text="{loc:Translate Label_Book}" FontSize="12"/>
                    </HorizontalStackLayout>
                </Button>

                <Button Text="{loc:Translate Label_Book}" FlexLayout.Grow="1" Command="{Binding GoToBookCommand}" Style="{StaticResource BottomBarButtonStyle}" />
                <Button Text="{loc:Translate Label_Record}" FlexLayout.Grow="1" Command="{Binding ViewRecordCommand}" Style="{StaticResource BottomBarButtonStyle}" />
                <Button Text="+" FlexLayout.Grow="1" Command="{Binding AddRecordCommand}" Style="{StaticResource BottomBarPrimaryButtonStyle}" />
                <Button Text="{loc:Translate Label_Account}" FlexLayout.Grow="1" Command="{Binding ViewAccountCommand}" Style="{StaticResource BottomBarButtonStyle}"/>
                <Button Text="{loc:Translate Label_Personal}" FlexLayout.Grow="1" Command="{Binding ViewPersonalCommand}" Style="{StaticResource BottomBarButtonStyle}"/>
            </FlexLayout>
        </Border>
    </Grid>
</ContentPage>
