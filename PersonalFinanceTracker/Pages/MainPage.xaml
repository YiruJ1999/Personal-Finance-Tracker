<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PersonalFinanceTracker.PageModels"
             xmlns:models="clr-namespace:PersonalFinanceTracker.Models"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="PersonalFinanceTracker.Pages.MainPage"
             x:DataType="local:MainPageModel"
             BackgroundColor="White">

    <Grid RowDefinitions="*, Auto">

        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20">
                
                <!-- Current Book -->
                <Label Text="{Binding CurrentBook, StringFormat='当前账本: {0}'}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Start" BackgroundColor="Azure" />



                <!-- Monthly Summary -->
                <Label Text="本月收支平衡情况" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="5">

                    <Label Text="{Binding MonthlySummaryData[0].Label}" Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" />
                    <Label Text="{Binding MonthlySummaryData[1].Label}" Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" />
                    <Label Text="{Binding MonthlySummaryData[2].Label}" Grid.Row="0" Grid.Column="2" HorizontalOptions="Center" />
                    <Label Text="{Binding MonthlySummaryData[3].Label}" Grid.Row="0" Grid.Column="3" HorizontalOptions="Center" />


                    <Label Text="{Binding MonthlySummaryData[0].Amount, StringFormat='{}{0:C}'}" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" />
                    <Label Text="{Binding MonthlySummaryData[1].Amount, StringFormat='{}{0:C}'}" Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" />
                    <Label Text="{Binding MonthlySummaryData[2].Amount, StringFormat='{}{0:C}'}" Grid.Row="1" Grid.Column="2" HorizontalOptions="Center" />
                    <Label Text="{Binding MonthlySummaryData[3].Amount, StringFormat='{}{0:C}'}" Grid.Row="1" Grid.Column="3" HorizontalOptions="Center" >

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BuggetTappedCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>


                <!-- Monthly Category Chart -->
                <chart:SfCartesianChart HeightRequest="300">
                    <chart:SfCartesianChart.XAxes>
                        <chart:CategoryAxis />
                    </chart:SfCartesianChart.XAxes>
                    <chart:SfCartesianChart.YAxes>
                        <chart:NumericalAxis />
                    </chart:SfCartesianChart.YAxes>

                    <chart:SfCartesianChart.Series>
                        <chart:ColumnSeries ItemsSource="{Binding MonthlyCategoryChartData}"
                                            XBindingPath="Category"
                                            YBindingPath="Amount"
                                            ShowDataLabels="True" />
                    </chart:SfCartesianChart.Series>
                </chart:SfCartesianChart>

                <!-- Today's list -->
                <Label Text="今日收支" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding TodayRecords}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Record">
                            <Border BackgroundColor="#F5F5F5" Stroke="LightGray" StrokeThickness="1" Padding="10" Margin="5">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Category}" FontSize="16" />
                                    <Label FontSize="14">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource AmountWithSignConverter}">
                                                <Binding Path="Amount" />
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding Note}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="今日暂无记录" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
                    </CollectionView.EmptyView>
                </CollectionView>





            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                    Style="{StaticResource BottomBarContainerStyle}">
            <FlexLayout 
                Style="{StaticResource BottomBarFlexStyle}"                >

                <Button Text="账本"  FlexLayout.Grow="1" Command ="{Binding GoToBookCommand}" Style="{StaticResource BottomBarButtonStyle}" />
                <Button Text="账单" FlexLayout.Grow="1" Command ="{Binding ViewRecordCommand}" Style="{StaticResource BottomBarButtonStyle}" />
                <Button Text="+"    FlexLayout.Grow="1" Command ="{Binding AddRecordCommand}" Style="{StaticResource BottomBarButtonStyle}" />
                <Button Text="账户" FlexLayout.Grow="1" Command="{Binding ViewAccountCommand}" Style="{StaticResource BottomBarButtonStyle}"/>
                <Button Text="个人" FlexLayout.Grow="1" Command ="{Binding ViewPersonalCommand}" Style="{StaticResource BottomBarButtonStyle}"/>
                
            </FlexLayout>

        </Border>
    </Grid>
</ContentPage>
