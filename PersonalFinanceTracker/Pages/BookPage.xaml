<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PersonalFinanceTracker.PageModels"
             xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
             xmlns:resx="clr-namespace:PersonalFinanceTracker.Resources.Strings"
             x:Class="PersonalFinanceTracker.Pages.BookPage"
             x:Name="BookPageRoot"
             x:DataType="local:BookPageModel"
             Title="{loc:Translate Label_BookList}">

    <Grid RowDefinitions="*,Auto">

        <CollectionView
            x:Name="BooksView"
            ItemsSource="{Binding Books}"
            SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
            SelectionMode="Single"
            ItemSizingStrategy="MeasureAllItems"
            Margin="16"
            Grid.Row="0">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:BookSummary">

                    <Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter TargetName="Card" Property="Border.BackgroundColor" Value="{StaticResource Secondary}" />
                                        <Setter TargetName="Card" Property="Border.Stroke" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="Card" Property="Border.StrokeThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter TargetName="Card" Property="Border.BackgroundColor" Value="{StaticResource PrimaryLight}" />
                                        <Setter TargetName="Card" Property="Border.Stroke" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="Card" Property="Border.StrokeThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Card"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource Secondary}"
                                Stroke="{StaticResource PrimaryBrush}"
                                StrokeThickness="1"
                                Padding="16"
                                Margin="0,0,0,16">
                            <Border.Shadow>
                                <Shadow Opacity="0.14" Radius="10" Offset="0,3"/>
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="20">

                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="{Binding BookName}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}"
                                           VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                        <Label FontSize="14" VerticalTextAlignment="Center">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0}{1:yyyy-MM-dd HH:mm}">
                                                    <Binding Source="{x:Static resx:AppResources.Label_LastModified}" />
                                                    <Binding Path="LastModified" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        <ImageButton
                                            x:DataType="{x:Null}"
                                            Source="delete.png"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center"
                                            Padding="0"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            Command="{Binding Path=BindingContext.DropBookCommand, Source={x:Reference BookPageRoot}}"
                                            CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="20" Margin="0,4,0,0">
                                    <Label Grid.Column="0" Text="{loc:Translate Label_Income}"  HorizontalOptions="Center" />
                                    <Label Grid.Column="1" Text="{loc:Translate Label_Expense}" HorizontalOptions="Center" />
                                    <Label Grid.Column="2" Text="{loc:Translate Label_Balance}" HorizontalOptions="Center" />
                                    <Label Grid.Column="3" Text="{loc:Translate Label_Budget}"  HorizontalOptions="Center" />
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="20">
                                    <Label Grid.Column="0" Text="{Binding IncomeAmount,  StringFormat='{}{0:C}'}" HorizontalOptions="Center" TextColor="{StaticResource PrimaryDark}" />
                                    <Label Grid.Column="1" Text="{Binding ExpenseAmount, StringFormat='{}{0:C}'}" HorizontalOptions="Center" TextColor="{StaticResource PrimaryDark}" />
                                    <Label Grid.Column="2" Text="{Binding BalanceAmount, StringFormat='{}{0:C}'}" HorizontalOptions="Center" TextColor="{StaticResource PrimaryDark}" />
                                    <Label Grid.Column="3" Text="{Binding BudgetAmount,  StringFormat='{}{0:C}'}" HorizontalOptions="Center" TextColor="{StaticResource PrimaryDark}" />
                                </Grid>

                            </Grid>
                        </Border>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1" Style="{StaticResource BottomBarContainerStyle}">
            <FlexLayout Style="{StaticResource BottomBarFlexStyle}">
                <Button Text="{loc:Translate Btn_AddBook}"
                        Command="{Binding AddBookClickedCommand}"
                        Style="{StaticResource BottomBarButtonStyle}"
                        FlexLayout.Grow="1" />
            </FlexLayout>
        </Border>

    </Grid>
</ContentPage>
