<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalFinanceTracker.Pages.BookPage"
             Title="账本列表">

    <CollectionView ItemsSource="{Binding Books}"
                    Margin="20"
                    VerticalOptions="FillAndExpand"
                    SelectionMode="None">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border StrokeShape="RoundRectangle 10"
                        BackgroundColor="#DDAAFF"
                        StrokeThickness="0"
                        Padding="15"
                        Margin="0,0,0,20">

                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Book name -->
                        <Label Grid.Column="0"
                               Text="{Binding BookName}"
                               FontSize="20"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Start" />

                        <!-- Last modified -->
                        <Label Grid.Column="1"
                               Text="{Binding LastModified, StringFormat='最近修改时间: {0:yyyy-MM-dd HH:mm}'}"
                               FontSize="14"
                               HorizontalOptions="End"
                               VerticalOptions="Center" />

                        <!-- Header row -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2"
                              ColumnSpacing="20"
                              Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="收入" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="支出" HorizontalOptions="Center" />
                            <Label Grid.Column="2" Text="结余" HorizontalOptions="Center" />
                            <Label Grid.Column="3" Text="预算" HorizontalOptions="Center" />
                        </Grid>

                        <!-- Data row -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="2"
                              ColumnSpacing="20"
                              Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Text="{Binding IncomeAmount, StringFormat='{0:C}'}"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding ExpenseAmount, StringFormat='{0:C}'}"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="{Binding BalanceAmount, StringFormat='{0:C}'}"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="3"
                                   Text="{Binding BudgetAmount, StringFormat='{0:C}'}"
                                   HorizontalOptions="Center" />
                        </Grid>

                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
