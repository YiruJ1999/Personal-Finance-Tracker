<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
            x:Class="PersonalFinanceTracker.Pages.AccountDetailPage"
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:pm="clr-namespace:PersonalFinanceTracker.PageModels"
            xmlns:m="clr-namespace:PersonalFinanceTracker.Models"
            xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
            x:DataType="pm:AccountDetailPageModel"
            Title="{Binding AccountName}">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" ColumnDefinitions="*,Auto">
        <!-- Total amount -->
        <Label Grid.Row="0"
               Text="{Binding TotalAmountText}"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Edit account button -->
        <Button Grid.Row="1" Text="{loc:Translate Btn_EditAccount}" FontSize="16"
                Command="{Binding EditAccountCommand}" 
                HorizontalOptions="Center"
                Style="{StaticResource GhostHoverButton}" />

        <!-- Month picker row -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="0,8,0,8">
            <Label Grid.Column="0" Text="{loc:Translate Label_MonthDetail}" FontAttributes="Bold" />
            <!-- Month selector on the right -->
            <Picker Grid.Column="1" WidthRequest="170"
                    Title="{loc:Translate Picker_ChooseMonth}"
                    ItemsSource="{Binding AvailableMonths}"
                    ItemDisplayBinding="{Binding Display}"
                    SelectedItem="{Binding SelectedMonth}" 
                    FontSize="16"/>
        </Grid>

        <!-- Monthly records list -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding MonthlyRecords}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:Record">
                    <Grid Padding="8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{Binding Category}" FontAttributes="Bold" FontSize="16"/>
                        <Label Grid.Column="1" HorizontalTextAlignment="End">
                            <Label.Text>
                                <MultiBinding Converter="{StaticResource AmountWithSignConverter}">
                                    <Binding Path="Amount"/>
                                    <Binding Path="Type" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Label Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding Note}" FontSize="12" TextColor="Gray"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>