<?xml version="1.0" encoding="utf-8" ?>
<!--
  Personal Finance Tracker
  File: PersonalFinanceTracker/Pages/BuggetPopup.xaml
  Purpose: Defines a user-facing MAUI page or popup layout.
-->
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
    x:Class="PersonalFinanceTracker.Pages.BuggetPopup"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Frame 
        BackgroundColor="White"
        BorderColor="LightGray"
        CornerRadius="20"
        Padding="20"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="300">

        <VerticalStackLayout Spacing="15">
            <Entry x:Name="AmountEntry"
               Placeholder="{loc:Translate Entry_Budget}"
               Keyboard="Numeric"
               TextChanged="AmountEntry_TextChanged"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                <Button Text="{loc:Translate Btn_Confirm}" Clicked="ConfirmClicked" />
                <Button Text="{loc:Translate Btn_Cancel}" Clicked="CancelClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

    </Frame>


</toolkit:Popup>

