<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PersonalFinanceTracker.PageModels"
             xmlns:models="clr-namespace:PersonalFinanceTracker.Models"
             xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
             xmlns:conv="clr-namespace:PersonalFinanceTracker.Converters"
             x:Class="PersonalFinanceTracker.Pages.ViewRecordPage"
             x:DataType="local:ViewRecordPageModel"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:CategoryLocalizeConverter x:Key="CategoryLocalizeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- 使用 Grid 实现：上表头固定 + 下区域填充滚动 -->
    <Grid RowDefinitions="Auto,10,*" Padding="10">

        <!-- 表头：固定高度 -->
        <FlexLayout
            Direction="Row"
            JustifyContent="SpaceBetween"
            AlignItems="Center"
            Grid.Row="0"
            >
            <Label Text="{loc:Translate Label_Category}" FontSize="16" FlexLayout.Grow="1"/>
            <Label Text="{loc:Translate Label_Amount}" FontSize="16" FlexLayout.Grow="1"/>
            <Label Text="{loc:Translate Label_Note}" FontSize="16" FlexLayout.Grow="2"/>
        </FlexLayout>

        <!-- 数据列表：自动填满剩余空间 -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Records}"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}"
                        >
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Record">
                    <Border BackgroundColor="#F5F5F5"
                            Stroke="LightGray"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="5">
                        <FlexLayout Direction="Row"
                                    JustifyContent="SpaceBetween"
                                    AlignItems="Center">
                            <Label Text="{Binding Category, Converter={StaticResource CategoryLocalizeConverter}}" FlexLayout.Grow="1"  />
                            <Label Text="{Binding Amount, StringFormat='{}{0:C}'}" FlexLayout.Grow="1"  />
                            <Label Text="{Binding Note}" FlexLayout.Grow="2" />

                        </FlexLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="{loc:Translate Label_EmptyList}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray" />
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>
