<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="PersonalFinanceTracker.Pages.DeleteRecordPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
    Color="Transparent"
    >

    <!-- Simple rounded card -->
    <Border Padding="16"
            BackgroundColor="White"
            Stroke="{StaticResource Primary}"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 20">
        <Border.Shadow>
            <Shadow Brush="#33000000" Offset="0,4" Radius="12" Opacity="0.5" />
        </Border.Shadow>
        <VerticalStackLayout Spacing="16" WidthRequest="280">
            <!-- Message -->
            <Label x:Name="MsgLabel"
                   Text="{loc:Translate Dialog_DeleteRecordMsg}"
                   HorizontalTextAlignment="Center"
                   FontSize="Default"
                   Style="{StaticResource Caption1Strong}" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                <Button Text="{loc:Translate Btn_Cancel}"
                        Style="{StaticResource BottomBarButtonStyle}"
                        FontSize="Small"
                        Clicked="OnCancelClicked" />
                <Button Text="{loc:Translate Btn_Delete}"
                        Style="{StaticResource BottomBarButtonStyle}"
                        FontSize="Small"                        
                        Clicked="OnDeleteClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
