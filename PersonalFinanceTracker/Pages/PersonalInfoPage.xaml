<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfavatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
    x:Class="PersonalFinanceTracker.Pages.PersonalInfoPage">

    <Grid RowDefinitions="*,Auto">
        

        <VerticalStackLayout Padding="20" Spacing="20"
                             Grid.Row="0">

            <!-- Avatar with edit button -->
            <Grid>
                <sfavatar:SfAvatarView
                    WidthRequest="100"
                    HeightRequest="100"
                    CornerRadius="50"
                    AvatarShape="Circle"
                    ImageSource="{Binding AvatarPath}"/>

                <Button
                    Text="✏️"
                    BackgroundColor="Transparent"
                    WidthRequest="30"
                    HeightRequest="30"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Clicked="OnEditAvatarClicked"
                    Margin="0,0,5,5" />
            </Grid>

            <!-- Username with edit button -->
            <Grid>
                <Label
                    Text="{Binding Name}"
                    FontSize="20"
                    HorizontalOptions="Center" />

                <Button
                    Text="✏️"
                    BackgroundColor="Transparent"
                    WidthRequest="30"
                    HeightRequest="30"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Clicked="OnEditNameClicked"
                    Margin="0,0,5,0" />
            </Grid>

            <!-- Currency picker -->
            <Picker Title="{loc:Translate Picker_Currency}"
                    ItemsSource="{Binding CurrencyOptions}"
                    SelectedItem="{Binding CurrencyCode, Mode=TwoWay}" />

            <!-- Language picker -->
            <Picker
                Title="{loc:Translate Picker_Language}"
                ItemsSource="{Binding LanguageOptions}"
                ItemDisplayBinding="{Binding DisplayName}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />


        </VerticalStackLayout>
            
        <Border Grid.Row="1" Style="{StaticResource BottomBarContainerStyle}">
            <FlexLayout Style="{StaticResource BottomBarFlexStyle}">
                <Button Text="{loc:Translate Btn_Save}" Clicked="OnSaveClicked" 
                    Style="{StaticResource BottomBarButtonStyle}"
                    FlexLayout.Grow="1" />
            </FlexLayout>
        </Border>

    </Grid> 
</ContentPage>
