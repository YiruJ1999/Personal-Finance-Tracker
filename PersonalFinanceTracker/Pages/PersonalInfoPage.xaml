<?xml version="1.0" encoding="utf-8" ?>
<!--
  Personal Finance Tracker
  File: PersonalFinanceTracker/Pages/PersonalInfoPage.xaml
  Purpose: Defines a user-facing MAUI page or popup layout.
-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfavatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
    x:Class="PersonalFinanceTracker.Pages.PersonalInfoPage">

    <Grid RowDefinitions="*,Auto">

        <Border Grid.Row="0"
                Stroke="{StaticResource PrimaryBrush}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="{StaticResource Secondary}"
                Padding="20"
                Margin="16">
            <VerticalStackLayout Spacing="20">

                <Grid>
                    <sfavatar:SfAvatarView
                        WidthRequest="100"
                        HeightRequest="100"
                        CornerRadius="50"
                        AvatarShape="Circle"
                        Background="Transparent"
                        ContentType="Custom">
                        <Image Source="{Binding Avatar}" Aspect="AspectFill"/>
                    </sfavatar:SfAvatarView>
                    <ImageButton
                        Source="pencil.png"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="28"
                        HeightRequest="28"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,5,5"
                        Clicked="OnEditAvatarClicked"/>
                </Grid>

                <Grid>
                    <Label
                        Text="{Binding Name}"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource PrimaryDark}"
                        HorizontalOptions="Center"
                        VerticalTextAlignment="Center"/>
                    <ImageButton
                        Source="pencil.png"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Margin="0,0,5,0"
                        Clicked="OnEditNameClicked"/>
                </Grid>

                <Picker Title="{loc:Translate Picker_Currency}"
                        ItemsSource="{Binding CurrencyOptions}"
                        SelectedItem="{Binding CurrencyCode, Mode=TwoWay}"
                        TextColor="{StaticResource DarkOnLightBackground}"
                        TitleColor="{StaticResource PrimaryDark}"/>

                <Picker Title="{loc:Translate Picker_Language}"
                        ItemsSource="{Binding LanguageOptions}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                        TextColor="{StaticResource DarkOnLightBackground}"
                        TitleColor="{StaticResource PrimaryDark}"/>

            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource BottomBarContainerStyle}">
            <FlexLayout Style="{StaticResource BottomBarFlexStyle}">
                <Button Text="{loc:Translate Btn_Save}"
                        Clicked="OnSaveClicked"
                        Style="{StaticResource BottomBarButtonStyle}"
                        FlexLayout.Grow="1"/>
            </FlexLayout>
        </Border>

    </Grid>
</ContentPage>


