<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:PersonalFinanceTracker.Services"
             xmlns:local="clr-namespace:PersonalFinanceTracker.PageModels"
             xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
             x:Class="PersonalFinanceTracker.Pages.AddRecordPage"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">

        <!-- Outer vertical scroll for the whole page -->
        <ScrollView Orientation="Vertical"
                Grid.Row="0">
            <!-- Use a simple vertical stack as the scroll content -->
            <VerticalStackLayout Padding="20" Spacing="10">

                <!-- Type Selection -->
                <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
                    <Button
                        Text="{loc:Translate Btn_Expense}"
                        Command="{Binding SelectExpenseCommand}"
                        TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        BackgroundColor="Transparent"
                        CornerRadius="8">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsExpenseSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderWidth" Value="0" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Grid.Column="1"
                            Text="{loc:Translate Btn_Income}"
                            Command="{Binding SelectIncomeCommand}"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            BackgroundColor="Transparent"
                            CornerRadius="8">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsExpenseSelected}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderWidth" Value="0" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>


                <!-- Category Selection: horizontal grid with 2 rows, fixed height, NO vertical scroll -->
                <CollectionView
                    ItemsSource="{Binding Categories}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedCategory}"
                    VerticalOptions="Start"
                    HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="{Binding CategoryColumns}" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile"
                                    Padding="6"
                                    Margin="4"
                                    Background="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                <Border.Content>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Image Grid.Row="0"
                                               Source="{Binding Icon}"
                                               HeightRequest="40" WidthRequest="40"
                                               HorizontalOptions="Center"
                                               BackgroundColor="Transparent"
                                               Aspect="AspectFit"/>
                                        <Label Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontSize="12"
                                               HorizontalOptions="Center"/>
                                    </Grid>
                                </Border.Content>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter TargetName="Tile" Property="StrokeThickness" Value="0"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter TargetName="Tile" Property="Stroke" Value="{StaticResource PrimaryDarkBrush}"/>
                                                <Setter TargetName="Tile" Property="StrokeThickness" Value="2"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- Account picker -->
                <Picker Title="{loc:Translate Picker_ChooseAccount}"
                        ItemsSource="{Binding Accounts}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                        FontSize="16"
                        TitleColor="{StaticResource PrimaryDark}"
                        TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"/>

                <!-- Note, Amount, Date -->
                <Entry Placeholder="{loc:Translate Entry_Note}" 
                       Text="{Binding Note}" 
                       FontSize="16"/>
                
                <Entry Keyboard="Numeric" 
                       Text="{Binding Amount}" 
                       FontSize="16"
                       Placeholder="{Binding Source={x:Static services:CurrencyManager.CurrentSymbol}, StringFormat='{}{0} 0.00'}"/>
                
                <DatePicker Date="{Binding SelectedDate}" FontSize="16"/>

                <!-- extra bottom space -->

            </VerticalStackLayout>
        </ScrollView>
        <Border 
            Grid.Row="1"
            Style="{StaticResource BottomBarContainerStyle}">
            <FlexLayout>
                <!-- Save Button -->
                <Button Text="{loc:Translate Btn_Save}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource BottomBarButtonStyle}"
                    FlexLayout.Grow="1"/>
            </FlexLayout>
        </Border>
    </Grid>
</ContentPage>
