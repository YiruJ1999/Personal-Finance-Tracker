<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
    x:Class="PersonalFinanceTracker.Popups.DeleteAccountPopup">
    <VerticalStackLayout Padding="16" Spacing="12" WidthRequest="320">
        <Label Text="{loc:Translate Label_DeleteAccount}" FontAttributes="Bold" FontSize="18" />
        <Label x:Name="MsgLabel" Text="{loc:Translate Label_DeleteAccountAlert}" />
        <CheckBox x:Name="AlsoDeleteRecordsCheck" />
        <Label Text="{loc:Translate Label_DeleteAccountAllDetail}" />
        <Grid ColumnDefinitions="*,Auto,Auto">
            <Label />
            <Button Grid.Column="1" Text="{loc:Translate Btn_Cancel}" Clicked="OnCancelClicked" />
            <Button Grid.Column="2" Text="{loc:Translate Btn_Delete}" BackgroundColor="IndianRed"
                    TextColor="White" Clicked="OnDeleteClicked" />
        </Grid>
    </VerticalStackLayout>
</toolkit:Popup>
