<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="PersonalFinanceTracker.Popups.DeleteAccountPopup">
    <VerticalStackLayout Padding="16" Spacing="12" WidthRequest="320">
        <Label Text="删除账户" FontAttributes="Bold" FontSize="18" />
        <Label x:Name="MsgLabel" Text="确定要删除此账户？" />
        <CheckBox x:Name="AlsoDeleteRecordsCheck" />
        <Label Text="同时删除该账户的所有明细记录" />
        <Grid ColumnDefinitions="*,Auto,Auto">
            <Label />
            <Button Grid.Column="1" Text="取消" Clicked="OnCancelClicked" />
            <Button Grid.Column="2" Text="删除" BackgroundColor="IndianRed"
                    TextColor="White" Clicked="OnDeleteClicked" />
        </Grid>
    </VerticalStackLayout>
</toolkit:Popup>
