<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
    x:Class="PersonalFinanceTracker.Popups.AddAccountPopup">
    <VerticalStackLayout Padding="16" Spacing="12" WidthRequest="320">
        <Label Text="{loc:Translate Label_AddAccount}" FontAttributes="Bold" FontSize="18" />
        <Entry x:Name="NameEntry" Placeholder="{loc:Translate Entry_AccountName}" />
        <Entry x:Name="OpeningEntry" Placeholder="{loc:Translate Entry_OpeningEntry}" Keyboard="Numeric" />
        <Grid ColumnDefinitions="*,Auto,Auto">
            <Label />
            <Button Grid.Column="1" Text="{loc:Translate Btn_Cancel}" Clicked="OnCancelClicked" />
            <Button Grid.Column="2" Text="{loc:Translate Btn_Save}" Clicked="OnSaveClicked" />
        </Grid>
    </VerticalStackLayout>
</toolkit:Popup>