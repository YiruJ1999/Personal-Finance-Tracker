<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:loc="clr-namespace:PersonalFinanceTracker.Localization"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    x:Class="PersonalFinanceTracker.Popups.AddAccountPopup">

    <!-- Card wrapper for teal theme -->
    <Border
        Background="{StaticResource Secondary}"            
        Stroke="{StaticResource AccentTeal}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 16"
        Padding="0">
        <Border.Shadow>
            <Shadow Opacity="0.25" Radius="20" Offset="0,6"/>
        </Border.Shadow>

        <VerticalStackLayout Padding="16" Spacing="14" WidthRequest="340">
            <Label
                Text="{loc:Translate Label_AddAccount}"
                FontAttributes="Bold" FontSize="18"
                TextColor="{StaticResource AccentTealDark}"/>

            <!-- Name input -->
            <sf:SfTextInputLayout Hint="{loc:Translate Entry_AccountName}">
                <sf:SfTextInputLayout.HintLabelStyle>
                    <sf:LabelStyle FontSize="13"/>
                </sf:SfTextInputLayout.HintLabelStyle>
                <Entry x:Name="NameEntry" FontSize="14"/>
            </sf:SfTextInputLayout>

            <!-- Opening balance input -->
            <sf:SfTextInputLayout Hint="{loc:Translate Entry_OpeningEntry}">
                <sf:SfTextInputLayout.HintLabelStyle>
                    <sf:LabelStyle FontSize="13"/>
                </sf:SfTextInputLayout.HintLabelStyle>
                <Entry x:Name="OpeningEntry" Keyboard="Numeric" FontSize="14"/>
            </sf:SfTextInputLayout>

            <!-- Actions -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                <Label/>
                <Button Grid.Column="1"
                        Text="{loc:Translate Btn_Cancel}"
                        FontSize="14"
                        Style="{StaticResource GhostHoverButton}"
                        TextColor="{StaticResource AccentTealDark}"
                        Clicked="OnCancelClicked"/>
                <Button Grid.Column="2"
                        Text="{loc:Translate Btn_Save}"
                        FontSize="14"
                        Clicked="OnSaveClicked"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
