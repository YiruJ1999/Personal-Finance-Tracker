<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="PersonalFinanceTracker.Popups.AddAccountPopup">
    <VerticalStackLayout Padding="16" Spacing="12" WidthRequest="320">
        <Label Text="添加账户" FontAttributes="Bold" FontSize="18" />
        <Entry x:Name="NameEntry" Placeholder="账户名称" />
        <Entry x:Name="OpeningEntry" Placeholder="期初余额（可选）" Keyboard="Numeric" />
        <Grid ColumnDefinitions="*,Auto,Auto">
            <Label />
            <Button Grid.Column="1" Text="取消" Clicked="OnCancelClicked" />
            <Button Grid.Column="2" Text="保存" Clicked="OnSaveClicked" />
        </Grid>
    </VerticalStackLayout>
</toolkit:Popup>