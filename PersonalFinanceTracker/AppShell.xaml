<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Personal Finance Tracker
  File: PersonalFinanceTracker/AppShell.xaml
  Purpose: Defines XAML resources or layout for the MAUI application.
-->
<Shell
    x:Class="PersonalFinanceTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:PersonalFinanceTracker.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="PersonalFinanceTracker">

    <ShellContent
        Title="Homepage"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="mainpage" />
</Shell>


