<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="PersonalFinanceTracker.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PersonalFinanceTracker"
    xmlns:conv="clr-namespace:PersonalFinanceTracker.Converters">

    <Application.Resources>
        <ResourceDictionary>

            <!-- 1) Only ResourceDictionary entries go here -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 2) Converter outside MergedDictionaries -->
            <conv:AmountWithSignConverter x:Key="AmountWithSignConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
